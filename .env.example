# Copy to .env.local for local dev (npm run dev). In production, set these
# in the Vercel project's Environment Variables settings instead — never
# commit real values.

# --- Server-only (used by api/*.js, never sent to the browser) ---

# Supabase Postgres connection string. Use the "Transaction pooler" string
# from Supabase Project Settings -> Database -> Connection string (port
# 6543), not the direct connection (port 5432) — Vercel functions are
# short-lived and many can run concurrently, which exhausts a direct
# connection's limit fast.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Project Settings -> API. Used server-side to verify the bearer token on
# every /api/query request.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxx

# --- Client-side (baked into the Vite bundle at build time, visible to anyone) ---

# Same two values as above. The anon key is meant to be public — it has no
# power on its own, it just identifies which Supabase project to talk to for
# sign-in. VITE_ prefix is required for Vite to expose these to the browser.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxx
